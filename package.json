{
  "name": "khloei",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "agent:dev": "bun --env-file=.env.local services/agent-worker/src/local.ts",
    "agent:install": "bun install --cwd services/agent-worker --frozen-lockfile",
    "agent:test": "bun run --cwd services/agent-worker test",
    "agent:typecheck": "bun run --cwd services/agent-worker typecheck",
    "computer:dev": "bun --env-file=.env.local services/computer/src/local.ts",
    "computer:install": "bun install --cwd services/computer --frozen-lockfile",
    "computer:test": "bun run --cwd services/computer test",
    "computer:typecheck": "bun run --cwd services/computer typecheck",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "eval:computer": "bun --env-file=.env.local evals/computer-agent/run.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:app && npm run agent:test && npm run computer:test",
    "test:app": "bun test app/lib/computer/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit && npm run agent:typecheck && npm run computer:typecheck"
  },
  "dependencies": {
    "@openai/agents": "^0.17.0",
    "@radix-ui/react-hover-card": "^1.1.23",
    "clsx": "^2.1.1",
    "lucide-react": "^1.29.0",
    "next": "16.3.2",
    "openai": "^7.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "thinking-orbs": "^0.2.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "1.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
