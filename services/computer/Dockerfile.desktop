# syntax=docker/dockerfile:1.7

# Khloei's Linux desktop.
#
# The display is Xvfb, not a VNC server. Khloei captures the X root window with
# ffmpeg and injects input with xdotool, and the person watching does so through
# the app's own scoped viewer socket, so a VNC stack was never on the path: it
# only ever supplied an X server and an Xfce session. Carrying one cost a 7.5 GB
# image, a multi-minute cold start, and a dependency on privileges that
# sandboxed container runtimes withhold, where its X server silently never
# started at all.
#
# Xvfb is the ordinary headless X server. It needs no display hardware and no
# elevated capabilities, and it is told its geometry at startup, which also
# removes the xrandr mode-setting that KasmVNC's 1024x768 default forced.
#
# Bullseye's older glibc keeps the copied Node binary compatible with the
# Debian Bookworm base.
FROM node:22-bullseye-slim@sha256:97924c8c7170c7a4c4464a281cc1f9569816496e546afbac17c4f2723397e116 AS node_runtime
FROM oven/bun:1.3.11@sha256:0733e50325078969732ebe3b15ce4c4be5082f18c4ac1a0f0ca4839c2e4e42a7 AS bun_runtime
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    WORKSPACE_DIR=/data/workspace \
    PROFILES_DIR=/data/profiles \
    AUDIT_DIR=/data/audit \
    KHLOEI_COMPUTER_SURFACE=desktop \
    KHLOEI_COMPUTER_SHELL_ENABLED=true \
    KHLOEI_DESKTOP_FRAME_RATE=30 \
    KHLOEI_DESKTOP_JPEG_QUALITY=2 \
    KHLOEI_DESKTOP_RESOLUTION=1920x1080 \
    DISPLAY=:1 \
    COMPUTER_CHROMIUM_EXECUTABLE=/usr/bin/google-chrome

# Xvfb is the display; xfce4 is the session a person actually sees; ffmpeg
# captures the root window; xdotool applies input only while the control state
# grants the wheel. The remainder is the toolchain the command runner needs.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    dbus-x11 \
    ffmpeg \
    fonts-dejavu-core \
    fonts-liberation \
    git \
    gnupg \
    jq \
    less \
    librsvg2-bin \
    procps \
    python3 \
    python3-pip \
    ripgrep \
    x11-utils \
    x11-xserver-utils \
    xdotool \
    xfce4 \
    xfce4-terminal \
    xvfb \
  && rm -rf /var/lib/apt/lists/*

# The browser Khloei drives through Playwright, and the one a person finds on
# the desktop.
#
# Google publishes Chrome and Microsoft publishes VS Code for amd64 only, so an
# amd64-only image forced emulation on an arm64 developer machine. Emulating it
# is not merely slower in aggregate: every input event spawns an xdotool
# process, and process spawn under translation costs far more than the X request
# it carries, which is felt directly as input lag while driving the desktop.
#
# arm64 therefore uses Debian's Chromium, which is the same engine Playwright
# drives, so a developer machine runs the desktop natively. VS Code publishes
# for both, so the desktop offers the same tools either way; only the browser
# package differs, and amd64 is what production deploys.
ARG TARGETARCH
RUN set -eux; \
  curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
    | gpg --dearmor -o /usr/share/keyrings/microsoft-vscode.gpg; \
  echo "deb [arch=${TARGETARCH} signed-by=/usr/share/keyrings/microsoft-vscode.gpg] https://packages.microsoft.com/repos/code stable main" \
    > /etc/apt/sources.list.d/vscode.list; \
  if [ "${TARGETARCH}" = "amd64" ]; then \
    curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
      | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg; \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" \
      > /etc/apt/sources.list.d/google-chrome.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends google-chrome-stable code; \
  else \
    apt-get update; \
    apt-get install -y --no-install-recommends chromium code; \
    ln -sf /usr/bin/chromium /usr/bin/google-chrome; \
  fi; \
  rm -rf /var/lib/apt/lists/*; \
  test -x /usr/bin/google-chrome; \
  command -v code

COPY --from=bun_runtime /usr/local/bin/bun /usr/local/bin/bun
COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node_runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/bin/bun /usr/local/bin/bunx \
  && ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
  && node --version \
  && npm --version

WORKDIR /app
COPY services/computer/package.json services/computer/bun.lock ./
RUN bun install --frozen-lockfile --production
# The repository layout is mirrored rather than flattened so the service's
# relative imports into `shared/` resolve identically in the image and the repo.
COPY shared ./shared
COPY services/computer/src ./services/computer/src

# The visible machine is Khloei's, so the wallpaper and desktop entries are too.
COPY services/computer/docker/khloei-wallpaper.svg /usr/share/backgrounds/khloei-wallpaper.svg
RUN rsvg-convert -w 1920 -h 1080 \
      /usr/share/backgrounds/khloei-wallpaper.svg \
      -o /usr/share/backgrounds/khloei-wallpaper.png

COPY services/computer/docker/khloei-code.desktop /etc/skel/Desktop/Khloei-Code.desktop
COPY services/computer/docker/khloei-workspace.desktop /etc/skel/Desktop/Khloei-Workspace.desktop
COPY services/computer/docker/desktop-entrypoint.sh /usr/local/bin/khloei-desktop-entrypoint.sh

# One unprivileged desktop user, matching the uid the entrypoint drops to and
# the ownership it repairs on a freshly attached volume. The desktop entries are
# staged outside the home directory because /home/khloei becomes a symlink onto
# the durable volume, which is empty until the entrypoint seeds it.
RUN useradd --uid 1000 --create-home --shell /bin/bash khloei \
  && chmod 0755 \
      /usr/local/bin/khloei-desktop-entrypoint.sh \
      /etc/skel/Desktop/Khloei-Code.desktop \
      /etc/skel/Desktop/Khloei-Workspace.desktop \
  && mkdir -p /data/home /data/workspace /data/profiles /data/audit \
  && rm -rf /home/khloei \
  && ln -s /data/home /home/khloei \
  && ln -s /data/workspace /workspace \
  && ln -s /data/profiles /profiles \
  && ln -s /data/audit /audit \
  && chown -R 1000:1000 /app /data

ENV HOME=/home/khloei \
    PORT=4100

VOLUME ["/data"]
EXPOSE 4100

HEALTHCHECK --interval=5s --timeout=4s --start-period=45s --retries=12 \
  CMD bun -e "const r = await fetch('http://127.0.0.1:4100/health'); const b = await r.json(); process.exit(r.ok && b.status === 'ok' && b.surface === 'desktop' && b.desktop?.ready && b.capabilities?.shell ? 0 : 1)"

# The entrypoint begins as root only long enough to repair ownership on a newly
# attached or legacy volume. It then drops uid, groups, capabilities, and future
# privilege escalation before either the desktop or command service starts.
USER root
WORKDIR /data/home
ENTRYPOINT ["/usr/local/bin/khloei-desktop-entrypoint.sh"]
